# Gemini: three AI Studio projects (quota is per project)
GEMINI_API_KEY_DEMO=
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_DATA=
GEMINI_VISION_MODEL=        # e.g. gemini-3.6-flash
GEMINI_TEXT_MODEL=          # e.g. gemini-3.6-flash
GEMINI_DATA_MODEL=          # e.g. gemini-3.6-flash (data pipeline, DATA key)
GEMINI_FALLBACK_MODELS=     # comma-separated, tried in order after the primary fails, e.g. gemini-3.5-flash-lite
GEMINI_MAX_TRIES=1          # tries per model before falling back
GEMINI_TIMEOUT_SECONDS=12
SARVAM_API_KEY=
FIRECRAWL_API_KEY=
BHASHINI_API_KEY=           # optional fallback
BACKEND_PORT=8765
DEMO_LANGS=hi,en
DEBUG_LOG_CONTENT=false

# Data pipeline
FETCH_ENGINE_DEFAULT=auto           # firecrawl | local | auto (firecrawl first, local on failure)
LOCAL_FETCH_DELAY_SECONDS=2.5       # pause between local (Playwright) requests
FIRECRAWL_CREDIT_BUDGET=1000        # fetch.py stops before exceeding this
GEMINI_DATA_RPM=10                  # extract.py paces Gemini calls to stay under the free-tier RPM
